{
  "name": "prism",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:gate": "node --test \"tests/gate/*.gate.mjs\"",
    "build": "rsbuild build",
    "start": "node scripts/serve.mjs",
    "smoke": "rsbuild build && node scripts/app-smoke.mjs --spawn",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.5",
    "better-sqlite3": "12.11.1",
    "highs": "1.15.3",
    "kysely": "0.29.6",
    "p-limit": "7.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "takumi-pdf": "0.14.3",
    "tldts": "7.4.18",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.14",
    "@rsbuild/plugin-react": "2.1.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
