# PRISM on prism-app (plan 07-12c) and the static findings site (plan 06-08). TLS ends here; the app
# container publishes no port.
# Only 443/tcp is open: no HTTP challenge, no HTTP-to-HTTPS redirect listener, no HTTP/3
# (UDP 443 stays closed). No email and no access log (client addresses are not logged).
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

# One host: the public findings site at the root, the private app under /app (base-path.mjs).
prism.helenkwok.dev {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	# Default forwarded headers: X-Forwarded-For (the client address; incoming values are
	# replaced because no trusted_proxies are set), X-Forwarded-Proto https, X-Forwarded-Host.
	@app path /app /app/*
	handle @app {
		reverse_proxy prism-app:3000
	}

	# The findings site: static files only, from a read-only mount. site/scripts/deploy.mjs puts each build in
	# /srv/prism/findings/releases/<id> and points the relative symlink current at it; caddy-headers is the
	# build's Content-Security-Policy (site/scripts/csp.mjs), the same policy as its _headers file.
	@findings file {
		root /srv/findings/current/client
		try_files {path} {path}/index.html {path}.html
	}
	handle @findings {
		root * /srv/findings/current/client
		# a glob, so a tree without a findings release still loads
		import /srv/findings/current/caddy-header*
		file_server {
			hide _headers
		}
	}

	# Anything else goes to the app: links from before the move (/p/..., /sign-in) are redirected under /app
	# by scripts/serve.mjs, and unknown paths get the app's 404.
	handle {
		reverse_proxy prism-app:3000
	}
}

# The findings' old host: every path moves to the same path on prism.helenkwok.dev.
findings.helenkwok.dev {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	redir https://prism.helenkwok.dev{uri} permanent
}
