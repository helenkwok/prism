# Allow-list build context (D-24): deny everything, then allow exactly the
# paths the Dockerfile copies. No agent-tool or planning directory is ever
# named here, on purpose - the deny-all-first form means none can slip in
# even if one is added to the working tree later.
#
# Both the bare directory and its recursive contents are un-ignored, because
# a plain `!dir/**` alone does not reliably re-include a directory entry that
# `*` already excluded.
*
!package.json
!package-lock.json
!requirements-gate.txt
!rsbuild.config.ts
!base-path.mjs
!postcss.config.mjs
!tsconfig.json
!docker
!docker/better-sqlite3
!docker/better-sqlite3/**
!src
!src/**
!scripts
!scripts/check-data-dir.mjs
!scripts/serve.mjs
!scripts/prepare-office-apps.mjs
!office-apps.lock.json
!site
!site/downloads.sha256
!scripts/spikes
!scripts/spikes/pick-projects.mjs
!scripts/spikes/lib
!scripts/spikes/lib/preflight.mjs
!scripts/spikes/lib/paths.mjs
!vendor
!vendor/**
!codebook.md
!protocol
!protocol/gap-text.json
!protocol/PROTOCOL.md
