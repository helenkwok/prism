{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alreadyopen.github.io/ai-output-to-value/schemas/v1/claim.schema.json",
  "title": "AI Output to Value claim record",
  "description": "Machine-readable decision record for the AI Output to Value stop-rule framework. The producer identity does not determine the gate; the target decision does. Workflow fields describe the end-to-end process boundary and do not create a seventh claim level.",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "targetDecision",
    "requiredClaimLevel",
    "assertedClaimLevel",
    "intendedUse",
    "actors",
    "authority",
    "accountability",
    "gateChecks",
    "nextEvidence",
    "stopRule"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1, "maxLength": 160 },
    "targetDecision": {
      "enum": ["explore", "rely", "operate", "measure-outcome", "scale-renew-stop"]
    },
    "requiredClaimLevel": {
      "enum": ["02-output", "03-deliverable", "04-capability", "05-outcome", "06-value"]
    },
    "assertedClaimLevel": {
      "enum": ["01-access", "02-output", "03-deliverable", "04-capability", "05-outcome", "06-value"]
    },
    "intendedUse": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "workflowBoundary": { "type": "string", "maxLength": 3000 },
    "workflowCompletion": { "type": "string", "maxLength": 2000 },
    "downstreamHandoffs": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    },
    "movedBottleneck": { "type": "string", "maxLength": 2000 },
    "unhappyPath": { "type": "string", "maxLength": 3000 },
    "evidenceCharacter": {
      "type": "array",
      "items": {
        "enum": ["public-measured", "public-documented", "internal", "illustrative", "editorial-synthesis"]
      },
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "role"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["human", "ai-agent", "deterministic-system", "specialist-tool", "hybrid"]
          },
          "role": { "type": "string", "minLength": 1, "maxLength": 500 },
          "interactionChannel": {
            "enum": ["human-ui", "webmcp", "mcp", "api", "cli", "ide-agent", "other-agent-tool", "hybrid", "other"]
          }
        }
      }
    },
    "assurance": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "authority": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "accountability": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "demonstrated": { "type": "string", "maxLength": 5000 },
    "inferredOrAssumed": { "type": "string", "maxLength": 5000 },
    "knownLimitations": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    },
    "outcomeMeasure": { "type": "string", "maxLength": 1000 },
    "baseline": { "type": "string", "maxLength": 1000 },
    "fullRelevantCostBoundary": { "type": "string", "maxLength": 2000 },
    "optionValue": { "type": "string", "maxLength": 2000 },
    "gateChecks": {
      "type": "object",
      "additionalProperties": {
        "enum": ["pass", "fail", "unknown", "not-applicable"]
      }
    },
    "nextEvidence": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "stopRule": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "notes": { "type": "string", "maxLength": 5000 }
  }
}
